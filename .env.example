# These are used by the SERVER (the /api folder). On Vercel you set them in
# Project -> Settings -> Environment Variables. To run the app on your PC, run
# "npx vercel env pull .env.local" (README, Part 2) and Vercel fills this file in for you.

# Added automatically when you connect the Neon database in Vercel (Storage tab).
DATABASE_URL=

# Your Google Apps Script Web App URL (ends with /exec). The Google Sheet is the backup.
SHEET_API_URL=

# The secret key made by createBackupKey() in the Apps Script. Keep it secret.
BACKUP_KEY=

# Only needed ONCE, to move your old Sheet data into the new database. Any long random text. Delete it afterwards.
SETUP_KEY=
